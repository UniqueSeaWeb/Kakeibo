{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kakeibo",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "preview_urls": false,
  // 画面ファイル（public/）は Worker に同梱して配信する
  "build": {
    "command": "node scripts/build-static.mjs",
    "watch_dir": "public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kakeibo",
      "database_id": "3eff77b8-6744-47b8-b507-fc02de8009f3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Cloudflare Access の設定値（秘密情報ではありません）
    "TEAM_DOMAIN": "https://REPLACE_WITH_TEAM_NAME.cloudflareaccess.com",
    "POLICY_AUD": "REPLACE_WITH_ACCESS_AUD_TAG",
    // 利用を許可するメールアドレス（カンマ区切り）。Access のポリシーと二重で確認します
    "ALLOWED_EMAILS": ""
  },
  "observability": { "enabled": true }
}
