{
  "name": "kakeibo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kakeibo --local",
    "db:migrate:remote": "wrangler d1 migrations apply kakeibo --remote",
    "build": "node scripts/build-static.mjs",
    "test": "node scripts/build-static.mjs && node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "4.155.0"
  }
}
